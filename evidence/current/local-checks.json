  "unit_tests": [
    {
      "suite": "it.sorguido.chromecastkillswitch.core.OperationEngineTest",
      "tests": 18,
      "failures": 0,
      "errors": 0,
      "skipped": 0,
      "cases": [
        "persistenceFailureBeforeFirstWriteCannotTouchTarget",
        "emptyTruncatedAndMultilineReadNeverBecomeOff",
        "unavailableBootEvidenceBlocksMutationAndRetainsPendingOnReconcile",
        "foreignTargetCannotBeMutatedEvenWithSameModel",
        "offRequiresAllNullBeforeRebootRatherThanJustAnOffClassification",
        "interruptedWriteAndUnrequestedRebootDoNotBecomeCompletedCycle",
        "partialWriteFailureDoesNotRebootOrAutomaticallyUndoProtection",
        "preflightRejectsWrongUserUnsupportedTargetMissingProtonAndForeignVpn",
        "changedBootWithWrongStateDoesNotClearPendingOrReplay",
        "failureToClearPendingDoesNotReportCompletedOperation",
        "nestedOperationIsRejectedBeforeSecondMutation",
        "explicitNewOperationCanReplacePendingAfterFreshPreflight",
        "rebootDisconnectSurvivesProcessRestartWithoutReplay",
        "onIsNotSuccessfulUntilNewCompletedBootIsRead",
        "offRemovesAllThreeKeysEvenFromPartialState",
        "ignoredWriteOrFailedReadbackPreventsReboot",
        "configurationSeparatesPartialAndConflictFromOff",
        "blankWhitelistNeedsACompleteLineNotMissingOutput"
      ]
    },
    {
      "suite": "it.sorguido.chromecastkillswitch.transport.ShellFrameTest",
      "tests": 5,
      "failures": 0,
      "errors": 0,
      "skipped": 0,
      "cases": [
        "rejectsMissingTruncatedDuplicateAndFailedFrames",
        "successfulNullIsNotAnEmptyResponse",
        "normalizesOnlyTerminalLineEndings",
        "bindsSerialFromAuthenticatedPairingGuid",
        "parsesOnlyNumericEndpoints"
      ]
    }
